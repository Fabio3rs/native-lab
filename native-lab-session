#!/bin/bash
set -euo pipefail

umask 077

readonly HOST_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PATH=$HOST_PATH
export PATH

readonly CONTROL_DIR=/run/native-lab-control
readonly SOCK="$CONTROL_DIR/lab-ssh.sock"
readonly MOUNTS_READY="$CONTROL_DIR/.mounts-ready"
readonly MOUNTS_RELEASE="$CONTROL_DIR/.mounts-release"
readonly MOUNT_RELEASE_TIMEOUT_SECONDS=5

die() {
    printf 'native-lab-session: %s\n' "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

need socat
need sshd
need ssh-keygen
need readlink

[[ -d "$CONTROL_DIR" && ! -L "$CONTROL_DIR" ]] || die "invalid control directory: $CONTROL_DIR"
chmod 700 "$CONTROL_DIR"

printf '%s\n' "$$" >"$MOUNTS_READY"
chmod 600 "$MOUNTS_READY"
deadline=$((SECONDS + MOUNT_RELEASE_TIMEOUT_SECONDS))
while [[ ! -e "$MOUNTS_RELEASE" ]] && (( SECONDS < deadline )); do
    sleep 0.05
done
[[ -f "$MOUNTS_RELEASE" && ! -L "$MOUNTS_RELEASE" ]] ||
    die 'daemon did not release mount setup before timeout'
rm -f -- "$MOUNTS_READY" "$MOUNTS_RELEASE"

mkdir -p /run/sshd
chmod 755 /run/sshd

SSHD_BIN=$(command -v sshd)
HOST_KEY="$CONTROL_DIR/ssh_host_ed25519_key"
CLIENT_KEY="$CONTROL_DIR/client_ed25519"
AUTHORIZED_KEYS="$CONTROL_DIR/authorized_keys"
KNOWN_HOSTS="$CONTROL_DIR/known_hosts"
CONFIG="$CONTROL_DIR/sshd_config"
INETD_WRAPPER="$CONTROL_DIR/sshd-inetd.sh"
USER_FILE="$CONTROL_DIR/user"

[[ -s "$HOST_KEY" ]] || ssh-keygen -q -t ed25519 -N '' -f "$HOST_KEY"
[[ -s "$CLIENT_KEY" ]] || ssh-keygen -q -t ed25519 -N '' -f "$CLIENT_KEY"

LOGIN_USER=$(id -un)
printf '%s\n' "$LOGIN_USER" >"$USER_FILE"
cat "$CLIENT_KEY.pub" >"$AUTHORIZED_KEYS"
chmod 600 "$HOST_KEY" "$CLIENT_KEY" "$AUTHORIZED_KEYS"
chmod 644 "$HOST_KEY.pub" "$CLIENT_KEY.pub" "$USER_FILE"

{
    printf 'native-lab '
    awk '{print $1, $2}' "$HOST_KEY.pub"
} >"$KNOWN_HOSTS"
chmod 600 "$KNOWN_HOSTS"

cat >"$CONFIG" <<EOF
HostKey $HOST_KEY
PidFile none

PubkeyAuthentication yes
AuthenticationMethods publickey
AuthorizedKeysFile $AUTHORIZED_KEYS
StrictModes no

PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
UsePAM no

AllowUsers $LOGIN_USER
PermitRootLogin prohibit-password

DisableForwarding yes
PermitTTY no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
PermitUserEnvironment no
PermitUserRC no

PrintMotd no
PrintLastLog no
UseDNS no
LogLevel VERBOSE
EOF
chmod 600 "$CONFIG"

cat >"$INETD_WRAPPER" <<EOF
#!/usr/bin/env sh
exec "$SSHD_BIN" -i -e -f "$CONFIG"
EOF
chmod 700 "$INETD_WRAPPER"

rm -f -- "$SOCK"
LISTENER_PID=
cleanup() {
    local status=$?
    trap - EXIT INT TERM HUP
    if [[ -n "$LISTENER_PID" ]]; then
        kill "$LISTENER_PID" 2>/dev/null || true
        wait "$LISTENER_PID" 2>/dev/null || true
    fi
    rm -f -- "$SOCK"
    exit "$status"
}
trap cleanup EXIT INT TERM HUP

printf 'native-lab session readying\n'
printf '  workspace: %s\n' "${NATIVE_LAB_WORKSPACE:-unknown}"
printf '  session:   %s\n' "${NATIVE_LAB_SESSION_ID:-unknown}"
printf '  socket:    %s\n' "$SOCK"
printf '  netns:     %s\n' "$(readlink /proc/self/ns/net)"
printf '  mountns:   %s\n' "$(readlink /proc/self/ns/mnt)"

# Do not add socat's "stderr" address option: sshd diagnostics must never be
# copied into the SSH protocol byte stream.
socat "UNIX-LISTEN:$SOCK,fork,mode=0600" "EXEC:$INETD_WRAPPER" &
LISTENER_PID=$!
wait "$LISTENER_PID"
