#!/bin/bash
set -Eeuo pipefail

umask 077

readonly HOST_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PATH=$HOST_PATH
export PATH
readonly MOUNT_SETUP_TIMEOUT_SECONDS=10

PHASE=initializing
stage() {
    PHASE=$1
    printf 'native-labd: [%s +%ss] %s\n' "${EPOCHREALTIME}" "$SECONDS" "$PHASE" >&2
}
trap 'status=$?; printf "native-labd: error phase=%s line=%s status=%s\n" "$PHASE" "$LINENO" "$status" >&2' ERR

# Called indirectly by the shutdown trap through dump_bwrap.
# shellcheck disable=SC2317
dump_process() {
    local pid=$1 line
    printf 'native-labd: process pid=%s\n' "$pid" >&2
    if [[ -r /proc/$pid/status ]]; then
        while IFS= read -r line; do
            case "$line" in Name:*|State:*|PPid:*) printf '  %s\n' "$line" >&2 ;; esac
        done <"/proc/$pid/status"
        printf '  wchan: %s\n' "$(cat "/proc/$pid/wchan" 2>/dev/null || true)" >&2
    else
        printf '  process no longer present\n' >&2
    fi
}

# Called indirectly by the shutdown trap.
# shellcheck disable=SC2317
dump_bwrap() {
    local child children
    dump_process "$BWRAP_PID"
    children=$(cat "/proc/$BWRAP_PID/task/$BWRAP_PID/children" 2>/dev/null || true)
    for child in $children; do dump_process "$child"; done
}

die() {
    printf 'native-labd: %s\n' "$*" >&2
    exit 1
}

write_atomic() {
    local destination=$1 temporary
    temporary="$destination.tmp.$$"
    cat >"$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$destination"
}

path_is_within() {
    local path=$1 root=$2
    [[ "$path" == "$root" || "$path" == "$root/"* ]]
}

resolve_host_tool() {
    local name=$1 variable=$2 candidate canonical
    candidate=$(command -v -- "$name" 2>/dev/null) || die "missing dependency: $name"
    [[ "$candidate" == /* ]] || die "host tool did not resolve to an absolute path: $name"
    canonical=$(realpath -- "$candidate") || die "cannot canonicalize host tool: $candidate"
    [[ -f "$canonical" && -x "$canonical" ]] || die "host tool is not executable: $canonical"
    if path_is_within "$canonical" "$WORKSPACE"; then
        die "refusing host tool resolved inside the workspace: $name -> $canonical"
    fi
    printf -v "$variable" '%s' "$canonical"
}

WORKSPACE=
SESSION_DIR=
SESSION_ID=
PROFILE=
POLICY_VERSION=
POLICY_DIGEST=
POLICY_FILE=
POLICY_HELPER=
RUNTIME_ROOT=
BWRAP_BIN=
PYTHON_BIN=
FLOCK_BIN=

while (($#)); do
    case "$1" in
        --workspace) WORKSPACE=${2-}; shift 2 ;;
        --session-dir) SESSION_DIR=${2-}; shift 2 ;;
        --session-id) SESSION_ID=${2-}; shift 2 ;;
        --profile) PROFILE=${2-}; shift 2 ;;
        --policy-version) POLICY_VERSION=${2-}; shift 2 ;;
        --policy-digest) POLICY_DIGEST=${2-}; shift 2 ;;
        --policy-file) POLICY_FILE=${2-}; shift 2 ;;
        --policy-helper) POLICY_HELPER=${2-}; shift 2 ;;
        --runtime-root) RUNTIME_ROOT=${2-}; shift 2 ;;
        *) die "unknown or incomplete argument: $1" ;;
    esac
done

[[ -n "$WORKSPACE" && -n "$SESSION_DIR" && -n "$SESSION_ID" &&
   -n "$PROFILE" && -n "$POLICY_VERSION" && -n "$POLICY_DIGEST" &&
   -n "$POLICY_FILE" && -n "$POLICY_HELPER" && -n "$RUNTIME_ROOT" ]] ||
    die 'incomplete configuration'
[[ "$WORKSPACE" == /* && "$SESSION_DIR" == /* && "$POLICY_FILE" == /* &&
   "$POLICY_HELPER" == /* && "$RUNTIME_ROOT" == /* ]] || die 'paths must be absolute'
[[ -d "$WORKSPACE" && -d "$SESSION_DIR" && ! -L "$SESSION_DIR" ]] ||
    die 'invalid workspace or session directory'
[[ -d "$RUNTIME_ROOT" && ! -L "$RUNTIME_ROOT" ]] || die 'invalid runtime root'
path_is_within "$SESSION_DIR" "$RUNTIME_ROOT" || die 'session directory is outside runtime root'
[[ "$POLICY_DIGEST" =~ ^[0-9a-f]{64}$ ]] || die 'invalid policy digest'
[[ "$POLICY_VERSION" == 3 ]] || die 'unsupported policy version'
[[ -r "$POLICY_FILE" && -r "$POLICY_HELPER" ]] || die 'policy files are not readable'

resolve_host_tool bwrap BWRAP_BIN
resolve_host_tool python3 PYTHON_BIN
resolve_host_tool flock FLOCK_BIN

SCRIPT_DIR=$(dirname -- "$(realpath -- "$0")")
SESSION_SCRIPT="$SCRIPT_DIR/native-lab-session"
[[ -x "$SESSION_SCRIPT" ]] || die "missing executable: $SESSION_SCRIPT"

stage 'verifying policy'
"$PYTHON_BIN" -I "$POLICY_HELPER" verify \
    --policy "$POLICY_FILE" \
    --workspace "$WORKSPACE" \
    --policy-version "$POLICY_VERSION" \
    --policy-digest "$POLICY_DIGEST"

CONTROL_DIR="$SESSION_DIR/control"
PID_FILE="$SESSION_DIR/holder.pid"
INFO_FILE="$SESSION_DIR/session.info"
SUMMARY_FILE="$SESSION_DIR/policy-summary.$$"
BWRAP_ARGS_FILE="$SESSION_DIR/bwrap-args.$$"
SYNTHETIC_FILE="$SESSION_DIR/synthetic-targets.$$"
MASK_SOURCE="$SESSION_DIR/deny-mask"
MOUNTS_READY="$CONTROL_DIR/.mounts-ready"
MOUNTS_RELEASE="$CONTROL_DIR/.mounts-release"
POLICY_MOUNT_LOCK="$RUNTIME_ROOT/policy-mount.lock"
[[ -d "$CONTROL_DIR" && ! -L "$CONTROL_DIR" ]] ||
    die "invalid control directory: $CONTROL_DIR"

stage 'reading policy summary'
"$PYTHON_BIN" -I "$POLICY_HELPER" summary --policy "$POLICY_FILE" >"$SUMMARY_FILE"
HOME_VALUE=$(awk -F= '$1 == "home" { print substr($0, index($0, "=") + 1); exit }' "$SUMMARY_FILE")
[[ -n "$HOME_VALUE" && "$HOME_VALUE" == /* ]] || die 'policy has invalid sandbox home'

START_TICKS=$(awk '{print $22}' "/proc/$$/stat")
{
    printf 'pid=%s\n' "$$"
    printf 'start_ticks=%s\n' "$START_TICKS"
    printf 'session_id=%s\n' "$SESSION_ID"
} | write_atomic "$PID_FILE"

{
    printf 'workspace=%s\n' "$WORKSPACE"
    printf 'profile=%s\n' "$PROFILE"
    printf 'policy_version=%s\n' "$POLICY_VERSION"
    printf 'created=%s\n' "$(date --iso-8601=seconds)"
    printf 'holder_pid=%s\n' "$$"
    cat "$SUMMARY_FILE"
} | write_atomic "$INFO_FILE"
rm -f -- "$SUMMARY_FILE"

: >"$MASK_SOURCE"
chmod 000 "$MASK_SOURCE"
stage 'generating bubblewrap mount plan'
"$PYTHON_BIN" -I "$POLICY_HELPER" emit-bwrap \
    --policy "$POLICY_FILE" \
    --mask-source "$MASK_SOURCE" \
    --args-output "$BWRAP_ARGS_FILE" \
    --synthetic-output "$SYNTHETIC_FILE"
rm -f -- "$SYNTHETIC_FILE"
# These are planned operations, not evidence that a mount has completed.
PLAN_FILE="$SESSION_DIR/bwrap-plan.txt"
argument_count=0
{
    while IFS= read -r -d '' argument; do
        printf '%q\n' "$argument"
        argument_count=$((argument_count + 1))
    done <"$BWRAP_ARGS_FILE"
} >"$PLAN_FILE"
printf 'native-labd: planned policy bwrap arguments=%s; full plan: %s\n' "$argument_count" "$PLAN_FILE" >&2
exec {BWRAP_ARGS_FD}<"$BWRAP_ARGS_FILE"

rm -f -- "$MOUNTS_READY" "$MOUNTS_RELEASE"
exec {POLICY_LOCK_FD}>"$POLICY_MOUNT_LOCK"
stage 'waiting for policy mount lock'
"$FLOCK_BIN" -x "$POLICY_LOCK_FD"
stage 'policy mount lock acquired'

BWRAP_PID=
SYNTHETICS_REGISTERED=0
POLICY_LOCK_HELD=1

# Callback invoked indirectly by the EXIT/signal trap.
# shellcheck disable=SC2317
unregister_synthetics() {
    (( SYNTHETICS_REGISTERED )) || return 0
    if (( ! POLICY_LOCK_HELD )); then
        exec {POLICY_LOCK_FD}>"$POLICY_MOUNT_LOCK" || return 1
        "$FLOCK_BIN" -x "$POLICY_LOCK_FD" || return 1
        POLICY_LOCK_HELD=1
    fi
    if ! "$PYTHON_BIN" -I "$POLICY_HELPER" unregister-synthetics \
        --policy "$POLICY_FILE" \
        --runtime-root "$RUNTIME_ROOT" \
        --session-id "$SESSION_ID"; then
        return 1
    fi
    SYNTHETICS_REGISTERED=0
}

# Callback invoked indirectly by trap.
# shellcheck disable=SC2317
shutdown() {
    local status=$?
    trap - EXIT INT TERM HUP
    printf 'native-labd: shutdown phase=%s status=%s\n' "$PHASE" "$status" >&2
    if [[ -n "$BWRAP_PID" ]]; then
        dump_bwrap
        kill -TERM "$BWRAP_PID" 2>/dev/null || true
        wait "$BWRAP_PID" 2>/dev/null || true
    fi
    if ! unregister_synthetics; then
        printf 'native-labd: failed to clean synthetic mountpoints; preserving them fail-closed\n' >&2
    fi
    if (( POLICY_LOCK_HELD )); then
        "$FLOCK_BIN" -u "$POLICY_LOCK_FD" 2>/dev/null || true
        exec {POLICY_LOCK_FD}>&- 2>/dev/null || true
    fi
    rm -f -- "$BWRAP_ARGS_FILE" "$MOUNTS_READY" "$MOUNTS_RELEASE"
    exit "$status"
}
trap shutdown EXIT INT TERM HUP

# Missing protected metadata needs a real mountpoint because bubblewrap cannot
# create a child mount below a bind-mounted workspace without creating that
# directory in the host workspace. Keep an ownership marker for the full
# session lifetime; unregister_synthetics removes the empty placeholder only
# after the last session using it exits.
SYNTHETICS_REGISTERED=1
stage 'registering synthetic mountpoints'
"$PYTHON_BIN" -I "$POLICY_HELPER" register-synthetics \
    --policy "$POLICY_FILE" \
    --runtime-root "$RUNTIME_ROOT" \
    --session-id "$SESSION_ID" \
    --pid "$$" \
    --start-ticks "$START_TICKS"

INTERNAL_SESSION_SCRIPT=/run/native-lab-bootstrap/native-lab-session
USER_VALUE=$(id -un)
# Recheck immediately before bubblewrap. The bootstrap checks the mounted
# identities again before announcing readiness, closing the path-bind gap.
stage 'validating GPU policy on host before launch'
"$PYTHON_BIN" -I "$POLICY_HELPER" validate-gpu --policy "$POLICY_FILE"
printf 'native-labd: bootstrap source=%q destination=/run/native-lab-bootstrap; control source=%q destination=/run/native-lab-control; proc=/proc; root remount=read-only; cwd=%q\n' "$SCRIPT_DIR" "$CONTROL_DIR" "$WORKSPACE" >&2
stage 'launching bubblewrap; waiting for bootstrap acknowledgement'
(
    exec {POLICY_LOCK_FD}>&-
    exec "$BWRAP_BIN" \
        --unshare-user \
        --unshare-pid \
        --unshare-ipc \
        --unshare-net \
        --unshare-uts \
        --hostname native-lab \
        --new-session \
        --die-with-parent \
        --cap-drop ALL \
        --args "$BWRAP_ARGS_FD" \
        --dir /run/native-lab-bootstrap \
        --ro-bind "$SESSION_SCRIPT" "$INTERNAL_SESSION_SCRIPT" \
        --ro-bind "$POLICY_HELPER" /run/native-lab-bootstrap/native-lab-policy.py \
        --ro-bind "$SCRIPT_DIR/native_lab_gpu.py" /run/native-lab-bootstrap/native_lab_gpu.py \
        --ro-bind "$SCRIPT_DIR/native-lab-gpu-probe.py" /run/native-lab-bootstrap/native-lab-gpu-probe.py \
        --ro-bind "$POLICY_FILE" /run/native-lab-bootstrap/resolved-policy.json \
        --dir /run/native-lab-control \
        --bind "$CONTROL_DIR" /run/native-lab-control \
        --proc /proc \
        --remount-ro / \
        --chdir "$WORKSPACE" \
        --clearenv \
        --setenv PATH "$HOST_PATH" \
        --setenv HOME "$HOME_VALUE" \
        --setenv USER "$USER_VALUE" \
        --setenv LOGNAME "$USER_VALUE" \
        --setenv SHELL /bin/sh \
        --setenv LANG C.UTF-8 \
        --setenv TMPDIR /tmp \
        --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)" \
        --setenv NATIVE_LAB_WORKSPACE "$WORKSPACE" \
        --setenv NATIVE_LAB_SESSION_ID "$SESSION_ID" \
        -- "$INTERNAL_SESSION_SCRIPT"
) &
BWRAP_PID=$!
printf 'native-labd: bubblewrap pid=%s acknowledgement=%q timeout=%ss\n' "$BWRAP_PID" "$MOUNTS_READY" "$MOUNT_SETUP_TIMEOUT_SECONDS" >&2
exec {BWRAP_ARGS_FD}>&-
rm -f -- "$BWRAP_ARGS_FILE"

deadline=$((SECONDS + MOUNT_SETUP_TIMEOUT_SECONDS))
while [[ ! -e "$MOUNTS_READY" ]] && (( SECONDS < deadline )); do
    if ! kill -0 "$BWRAP_PID" 2>/dev/null; then
        status=0
        wait "$BWRAP_PID" || status=$?
        BWRAP_PID=
        die "bubblewrap exited before bootstrap acknowledgement (status=$status); see preceding diagnostics"
    fi
    sleep 0.05
done
[[ -f "$MOUNTS_READY" && ! -L "$MOUNTS_READY" ]] ||
    die "bootstrap acknowledgement missing after ${MOUNT_SETUP_TIMEOUT_SECONDS}s; mount setup or bootstrap checks may be incomplete (see last stage and process state)"
stage 'bootstrap acknowledged; revalidating GPU policy on host'
"$PYTHON_BIN" -I "$POLICY_HELPER" validate-gpu --policy "$POLICY_FILE"
: >"$MOUNTS_RELEASE"
chmod 600 "$MOUNTS_RELEASE"
"$FLOCK_BIN" -u "$POLICY_LOCK_FD"
exec {POLICY_LOCK_FD}>&-
POLICY_LOCK_HELD=0
stage 'bootstrap released; waiting for sandbox process'

set +e
wait "$BWRAP_PID"
BWRAP_STATUS=$?
set -e
BWRAP_PID=
exit "$BWRAP_STATUS"
